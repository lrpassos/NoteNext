# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Chave secreta criptográfica para assinatura e verificação de sessões JWT locais
JWT_SECRET="notenext-enterprise-totp-jwt-secret-2026"

# ==============================================================================
# MICROSOFT ENTRA ID (AZURE AD) / MSAL CONFIGURATION
# ==============================================================================
# ID da aplicação (Client ID) registrado no Microsoft Entra ID (App Registrations)
VITE_AZURE_CLIENT_ID=""

# Tenant ID: "common" (corporativo + pessoal), "organizations" (apenas corporativo),
# ou o GUID específico do diretório no Azure Portal
VITE_AZURE_TENANT_ID="common"

# URI de redirecionamento configurada no registro como Single-Page Application (SPA)
VITE_AZURE_REDIRECT_URI="http://localhost:3000"

# Opcional para validação de tokens JWT no servidor Express:
AZURE_CLIENT_ID=""
AZURE_TENANT_ID="common"

# NOTA DE SEGURANÇA:
# No frontend Single-Page Application (SPA) com fluxo Authorization Code + PKCE (RFC 7636),
# o AZURE_CLIENT_SECRET NÃO é exposto nem utilizado no navegador para manter segurança.
# Apenas caso seu servidor atue como Confidential Client para chamadas de serviço em segundo plano:
# AZURE_CLIENT_SECRET=""

